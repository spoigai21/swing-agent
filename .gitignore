.venv/
__pycache__/
*.py[cod]
.env
# Any copy of .env holds real API keys (e.g. .env.bak-2026-09-14).
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
data/
*.log
.DS_Store

# Build artifacts. setuptools regenerates src/*.egg-info on every build, so a
# tracked copy produces a spurious diff after anyone runs `uv build`.
*.egg-info/
dist/
build/
*.whl
